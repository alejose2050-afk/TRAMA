# Configuración de PostgreSQL para desarrollo local
# IMPORTANTE: Copia este archivo a .env y define tus propios valores seguros.
# NUNCA subas el archivo .env al repositorio.

POSTGRES_DB=trama
POSTGRES_USER=trama_user
POSTGRES_PASSWORD=cambia_esta_contrasena_por_una_segura_local

# Configuración futura de Django (se utilizarán en la siguiente fase)
# DJANGO_SECRET_KEY=clave_secreta_insegura_solo_para_desarrollo_local
